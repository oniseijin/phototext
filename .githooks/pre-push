#!/bin/sh
# Public repo guardrail: main only advances on the public remote at tagged
# releases. Tag pushes are always allowed; other branches are untouched.
remote="$1"
zero="0000000000000000000000000000000000000000"

# only guard the public remote
url=$(git remote get-url "$remote" 2>/dev/null || echo "")
case "$url" in
  *github.com*) ;;
  *) exit 0 ;;
esac

while read local_ref local_sha remote_ref remote_sha; do
  [ "$remote_ref" = "refs/heads/main" ] || continue
  [ "$local_sha" = "$zero" ] && continue
  if [ -z "$(git tag --points-at "$local_sha")" ]; then
    echo "pre-push: refusing to push main to the public repo:" >&2
    echo "  $local_sha is not a tagged release." >&2
    echo "  Release flow: bump version + CHANGELOG, commit, then" >&2
    echo "  git tag vX.Y.Z && git push origin main vX.Y.Z" >&2
    exit 1
  fi
done
exit 0
